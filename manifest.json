{
  "name": "Place ID finder",
  "description": "Find, copy and open Google place IDs on supported Search and Travel pages.",
  "version": "1.4.0",
  "manifest_version": 3,
  "action": {
    "default_title": "Place ID finder",
    "default_popup": "popup.html"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/search*",
        "https://www.google.com/travel/*"
      ],
      "js": ["place-id-utils.js", "widget-styles.js", "content.js"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png",
    "512": "icons/icon-512.png"
  }
}
